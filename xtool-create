    # Xcode project UUIDs
    'PROJECT_ID': '{{PROJECT_ID}}',
    'MAIN_GROUP_ID': '{{MAIN_GROUP_ID}}',
    'APP_GROUP_ID': '{{APP_GROUP_ID}}',
    'PRODUCTS_GROUP_ID': '{{PRODUCTS_GROUP_ID}}',
    'NATIVE_TARGET_ID': '{{NATIVE_TARGET_ID}}',
    'BUILD_CONFIG_LIST_ID': '{{BUILD_CONFIG_LIST_ID}}',
    'PROJECT_BUILD_CONFIG_LIST_ID': '{{PROJECT_BUILD_CONFIG_LIST_ID}}',
    'SOURCES_BUILD_PHASE_ID': '{{SOURCES_BUILD_PHASE_ID}}',
    'FRAMEWORKS_BUILD_PHASE_ID': '{{FRAMEWORKS_BUILD_PHASE_ID}}',
    'RESOURCES_BUILD_PHASE_ID': '{{RESOURCES_BUILD_PHASE_ID}}',
    'CONTENT_VIEW_FILE_REF_ID': '{{CONTENT_VIEW_FILE_REF_ID}}',
