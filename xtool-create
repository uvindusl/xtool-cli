#!/usr/bin/env python3
"""
xtool-create: CLI tool to automate iOS app creation with Xcode + xtool + git

This tool automates the workflow:
1. Creates a new Xcode project from template
2. Sets up xtool project with symlinks to Swift files
3. Initializes git repository
4. Pushes to target directory (~/Documents/xtool-apps/<AppName>)
"""

import os
import sys
import shutil
import subprocess
import argparse
import uuid
import re
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Optional

try:
    import yaml
    HAS_YAML = True
except ImportError:
    HAS_YAML = False

# Configuration
# Try multiple locations for templates (installed vs development)
def _find_templates_dir() -> Path:
    """Find the templates directory."""
    # 1. Check installed location (~/.config/xtool-cli/templates)
    installed_templates = Path.home() / ".config" / "xtool-cli" / "templates"
    if installed_templates.exists():
        return installed_templates

    # 2. Check development location (same dir as script)
    script_dir = Path(__file__).parent
    dev_templates = script_dir / "templates"
    if dev_templates.exists():
        return dev_templates

    # 3. Fallback to installed location
    return installed_templates

TEMPLATES_DIR = _find_templates_dir()
XCODE_TEMPLATE_DIR = TEMPLATES_DIR / "xcode-project"
XTOOL_TEMPLATE_DIR = TEMPLATES_DIR / "xtool-project"
CONFIG_DIR = Path.home() / ".config" / "xtool-cli"
CONFIG_FILE = CONFIG_DIR / "config.yaml"

# Default configuration
DEFAULT_CONFIG = {
    'author': os.getenv("USER", "developer"),
    'team_id': '',
    'target_base_dir': str(Path.home() / "Documents" / "xtool-apps"),
    'bundle_id_prefix': f"com.{os.getenv('USER', 'developer').lower()}",
    'github': {
        'create_by_default': False,
        'private_by_default': False,
    },
    'xtool': {
        'vphone_cid': 3,
        'install_script': str(Path.home() / "Documents" / "vphone-linux" / "tools" / "install-ipa.py"),
    }
}

def load_config() -> Dict:
    """Load configuration from config file."""
    config = DEFAULT_CONFIG.copy()

    if CONFIG_FILE.exists() and HAS_YAML:
        try:
            with open(CONFIG_FILE) as f:
                user_config = yaml.safe_load(f)
                if user_config:
                    # Deep merge
                    for key, value in user_config.items():
                        if key in config and isinstance(config[key], dict) and isinstance(value, dict):
                            config[key].update(value)
                        else:
                            config[key] = value
        except Exception as e:
            print(f"Warning: Failed to load config: {e}", file=sys.stderr)

    return config


